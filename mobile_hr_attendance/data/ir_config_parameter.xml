<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Location on by default: it is what most companies want from mobile attendance. -->
    <record id="config_require_location" model="ir.config_parameter">
        <field name="key">mobile_hr_attendance.require_location</field>
        <field name="value">True</field>
    </record>
    <!-- Work areas: off until the company has drawn its areas; "warn" first, then "block". -->
    <record id="config_geofence_mode" model="ir.config_parameter">
        <field name="key">mobile_hr_attendance.geofence_mode</field>
        <field name="value">off</field>
    </record>
    <record id="config_geofence_max_accuracy" model="ir.config_parameter">
        <field name="key">mobile_hr_attendance.geofence_max_accuracy</field>
        <field name="value">100</field>
    </record>
    <record id="config_mock_policy" model="ir.config_parameter">
        <field name="key">mobile_hr_attendance.mock_policy</field>
        <field name="value">flag</field>
    </record>
</odoo>
